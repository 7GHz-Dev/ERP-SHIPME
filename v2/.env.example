# ---- Supabase Postgres ----
# Project Settings → Database → Connection string → **Transaction pooler** (พอร์ต 6543)
# ห้ามใช้ direct connection (5432) กับ Vercel — connection จะเต็มเมื่อมีหลาย function พร้อมกัน
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ---- Supabase Storage (รูปเช็กอิน / ใบเสร็จ / สลิป / ใบปิดบัญชี) ----
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role key ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=uploads

SESSION_HOURS=12
MAX_ACCURACY_METERS=200
MAX_ACCURACY_METERS_DESKTOP=5000

# ไม่ตั้ง = แสดงพิกัดเป็นที่อยู่ทันที (เร็วที่สุดและไม่ส่งพิกัดออกนอกระบบ)
GEOCODE_ENDPOINT=

# ---- อ่านสลิปอัตโนมัติ (OCR) ----
# ไม่ตั้งอะไรเลย = พนักงานกรอกยอด/วันที่/เลขที่รายการจากสลิปเอง (ระบบยังตรวจให้ว่าตรงกับยอดที่ต้องโอนไหม)
#
# Google Drive OCR — วิธีเดียวกับระบบเดิมบน Apps Script ฟรี ไม่ต้องเปิด billing
#
# แบบที่ 1 (แนะนำ): service account — ไม่มีอะไรหมดอายุ ตั้งครั้งเดียวจบ
# เอาค่าจากไฟล์ JSON ที่โหลดมาตอน Create key (ดู DEPLOY.md ข้อ 6)
#   EMAIL = ช่อง client_email / KEY = ช่อง private_key ทั้งก้อน (วาง \n ตามที่เห็นได้เลย)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
# โฟลเดอร์ใน Drive ของบัญชีคนจริงที่แชร์ให้ service account เป็น Editor
# จำเป็น เพราะ service account ไม่มีพื้นที่เก็บไฟล์ของตัวเอง (ไอดีเอาจากท้าย URL ของโฟลเดอร์)
GOOGLE_DRIVE_FOLDER_ID=
#
# แบบที่ 2 (เดิม): OAuth ของบัญชีผู้ใช้ — refresh token หมดอายุใน 7 วันถ้ายังเป็น Testing
# ขอค่าได้ด้วย: npx tsx scripts/google-oauth.mts <CLIENT_ID> <CLIENT_SECRET>
# ตั้งทั้งสองแบบพร้อมกันได้ ระบบจะเลือก service account ก่อน
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ทางเลือก 1: บริการ OCR ของตัวเอง เช่น PaddleOCR ในโฟลเดอร์ ocr/ (ดู ocr/README.md)
# ถ้าตั้งไว้จะถูกใช้ก่อน Drive OCR
OCR_ENDPOINT=
OCR_TOKEN=

# ทางเลือก 2: Google Cloud Vision (แม่นที่สุด แต่ต้องเปิด billing แม้ใช้โควตาฟรี 1,000 รูป/เดือน)
GOOGLE_VISION_API_KEY=

# true = อ่านสลิปไม่ออกแล้วห้ามบันทึก / false = บันทึกได้ แต่ติดสถานะรอผู้ดูแลตรวจ
SLIP_STRICT=false
# ยอดในสลิปต่างจากยอดที่ต้องโอนได้ไม่เกินกี่บาท (กันปัญหาปัดเศษสตางค์)
SLIP_AMOUNT_TOLERANCE=1

# ---- ชีตงานขนส่งยิงข้อมูลเข้ามาเอง (ดู TRANSPORT-SYNC.md) ----
# กุญแจให้ Apps Script ในชีตยิง action syncTransport/pruneTransport เข้ามาได้
# เว้นว่าง = ปิดรับ sync ทั้งหมด  |  สุ่มค่าด้วย: openssl rand -hex 24
TRANSPORT_SYNC_TOKEN=

# ---- SMS หาคนขับรถ (เมนูงานปล่อยของชิปปิ้ง) ผ่าน ThaiBulkSMS ----
# เอา API Key / Secret จาก https://account.thaibulksms.com → API Key
# ไม่ตั้ง = ปุ่มส่ง SMS ใช้ไม่ได้ แต่ชิปปิ้งยังกด "ส่งจากเครื่อง" (เปิดแอป SMS ในมือถือ) ได้ และยังติดตามการเปิดลิงก์/ตำแหน่งได้
THAIBULKSMS_API_KEY=
THAIBULKSMS_API_SECRET=
# ชื่อผู้ส่งที่ ThaiBulkSMS อนุมัติแล้ว (เว้นว่าง = ชื่อตั้งต้นของบัญชี)
THAIBULKSMS_SENDER=
# standard | corporate — ต้องตรงกับประเภทเครดิตที่ซื้อ
THAIBULKSMS_FORCE=standard
# true = ไม่ส่งจริง บันทึกเหมือนส่งสำเร็จ (ทดสอบหน้าจอก่อนเติมเครดิต)
SMS_DRY_RUN=false
# โดเมนสั้นสำหรับลิงก์ใน SMS (ลิงก์สั้น = เปลืองเครดิตน้อยลง) เว้นว่าง = ใช้โดเมนของระบบ
SMS_LINK_BASE=

# ---- ประสานงานคนขับผ่าน LINE OA (หน้า /staff สำหรับชิปปิ้ง, /driver สำหรับคนขับ) ----
# ไม่ครบ 4 ค่านี้ = DEMO MODE: ข้อความถูกบันทึกในระบบ (ดูได้ที่ "จำลองแชท LINE") แต่ไม่ส่งจริง
# Messaging API channel และ LINE Login channel ต้องอยู่ใต้ Provider เดียวกัน (userId ถึงจะตรงกัน)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ID=
# LIFF app ของ LINE Login channel — Endpoint URL = https://<โดเมน>/driver , Scope = openid profile
LIFF_ID=
# Webhook URL ที่ตั้งใน Messaging API = https://<โดเมน>/api/line/webhook

# Google Maps JavaScript API — จำกัดการใช้ด้วย HTTP referrer ของโดเมนระบบ
GOOGLE_MAPS_BROWSER_KEY=
# กุญแจลงลายเซ็น session คนขับ (ไม่ตั้งก็ได้)
DRIVER_SESSION_SECRET=
# Google Routes API (วางเส้นทางแจก EIR) — key ฝั่งเซิร์ฟเวอร์ เปิดเฉพาะ Routes API
# ไม่ตั้ง = ใช้เวลาประมาณการจากระยะทาง (ติดป้าย "ประมาณการ" ในหน้าจอ)
GOOGLE_ROUTES_SERVER_KEY=
