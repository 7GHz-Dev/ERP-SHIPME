{
  "name": "offsite-checkin",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify + SQLite backend for the off-site check-in system",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "import:legacy": "node scripts/import-legacy.mjs",
    "import:sheet-json": "node scripts/import-sheet-json.mjs",
    "import:transport": "node scripts/import-transport.mjs",
    "import:transport-json": "node scripts/import-transport-json.mjs"
  },
  "dependencies": {
    "fastify": "^5.6.0"
  }
}
