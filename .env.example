HOST=0.0.0.0
PORT=8080
DATA_DIR=./data
SESSION_HOURS=12
MAX_ACCURACY_METERS=200
MAX_ACCURACY_METERS_DESKTOP=5000
MAX_BODY_MB=15
TRUST_PROXY=false

# บัญชีที่สร้างเฉพาะตอนฐานข้อมูลว่างครั้งแรก
ADMIN_USERNAME=admin
ADMIN_PASSWORD=a
ADMIN_NAME=ผู้ดูแลระบบ

# ไม่ตั้ง = แสดงพิกัดเป็นที่อยู่ทันที (เร็วที่สุดและไม่ส่งพิกัดออกนอกระบบ)
# ตั้งเป็น URL ที่รับ GET ?lat=...&lon=... และตอบ {"address":"..."}
GEOCODE_ENDPOINT=

# ไม่ตั้ง = ให้ผู้ใช้กรอกยอด/วันที่/เลขรายการจากสลิปเอง
# ตั้งเป็น URL ที่รับ POST {"image":"data:image/..."} และตอบ {"text":"OCR text"}
OCR_ENDPOINT=
SLIP_STRICT=false
SLIP_AMOUNT_TOLERANCE=1
